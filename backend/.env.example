# Backend Local Environment Variables
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="SIH 2026 - Disaster Risk & Relocation Assessment"
VERSION=1.0.0
API_V1_STR=/api/v1

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_LOG_LEVEL=INFO

# Security / CORS (JSON array or comma-separated origins)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://localhost:80"]

# Database Connection (PostgreSQL + PostGIS)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sih_user
POSTGRES_PASSWORD=sih_password_secure_2026
POSTGRES_DB=sih_disaster_db
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}
